FROM node:25-alpine

WORKDIR /app/shared/database

COPY shared/database/package.json shared/database/package-lock.json ./
COPY shared/database/drizzle.config.ts ./
COPY shared/database/tsconfig.json ./
COPY tsconfig.base.json /app/

# drizzle-kit (needed at runtime by db:migrate:prod below) is a
# devDependency, so unlike api/web there's no separate --omit=dev runtime
# stage here - the full install has to stick around.
RUN npm ci

COPY shared/database/src ./src
# Copy migrations folder (generated by db:generate)
COPY shared/database/drizzle ./drizzle

# Build first, then run migrations + seed
RUN npm run build

CMD ["npm", "run", "db:setup:prod"]
