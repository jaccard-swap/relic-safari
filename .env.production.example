# Real production secrets file - copy this to .env.production directly on
# the box (never committed - see .gitignore) and fill in real values. Also
# symlink `.env -> .env.production` once (see docker-compose.prod.yaml's
# top comment - Compose's own ${GHCR_OWNER}/${IMAGE_TAG} substitution needs
# a literally-named `.env`).

# Your GitHub username/org - used to resolve the ghcr.io image names in
# docker-compose.prod.yaml.
GHCR_OWNER=

ENVIRONMENT=production
NODE_ENV=production

# Postgres runs locally in prod here (unlike a hosted DB) - pick a real
# password, DATABASE_URL below must match.
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=jaccard
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}

# Seeded once by db-setup on first deploy.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=

# api throws at boot in production if this is unset - generate a real
# random secret, don't leave it blank.
JWT_SECRET=

# Your domain without protocol - relic-safari.social once DNS propagates.
DOMAIN_NAME=relic-safari.social

# Real Sepolia RPC + the relayer/sponsor wallet's private key (plain key,
# not a mnemonic - production signs via SPONSOR_PRIVATE_KEY, see
# api/src/plugins/web3.ts) - see ROADMAP.md's "fund the relayer/sponsor
# wallet" step before sponsored transactions work.
SEPOLIA_RPC_URL=
SPONSOR_PRIVATE_KEY=

# Caps dig/quarry mints (nft_faucet) per wallet - enforced whenever
# NODE_ENV=production (unlimited dev minting only happens in NODE_ENV=
# development). Below is a 5-per-24h cap, same as .env.example's dev default.
RATE_LIMIT_WINDOW_MS=86400000
RATE_LIMIT_MAX=5
