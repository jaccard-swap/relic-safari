ENVIRONMENT=development
NODE_ENV=development

POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jaccard

REDIS_PORT=6179
REDIS_HOST=redis

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}


ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=

VITE_API_URL=http://api:3000
WEB_PORT=5173


JWT_SECRET=
# REQUIRED in production - your domain without protocol
DOMAIN_NAME=relic-safari.social

SEPOLIA_RPC_URL=
MNEMONIC=
ETHERSCAN_API_KEY=

# Local anvil network (chainId 31337). LOCALHOST_RPC_URL is for host-side
# `npm run deploy --workspace hardhat -- --network localhost`; the
# containerized deploy service overrides it to reach anvil by service name
# instead. MNEMONIC_LOCALHOST is the well-known Anvil/Hardhat test mnemonic -
# safe to commit since it only ever controls throwaway local funds.
LOCALHOST_RPC_URL=http://127.0.0.1:8545
MNEMONIC_LOCALHOST=test test test test test test test test test test test junk

# Caps dig/quarry mints (nft_faucet) per wallet - skipped entirely when
# NODE_ENV=development (unlimited dev minting is intentional), enforced
# otherwise. Below is a 5-per-24h cap.
RATE_LIMIT_WINDOW_MS=86400000
RATE_LIMIT_MAX=5